# =============================================================
# 环境变量配置模板
# 使用方法：
#   1. 复制本文件为项目根目录的 .env（.gitignore 已忽略 .env，不会误提交）
#        cp .env.example .env
#   2. 按下方说明填写三个作用域的 API 密钥
#   3. 提供商与模型在后台 Settings 页面选择，密钥只保存在本文件（后端读取）
# =============================================================


# -------------------------------------------------------------
# 一、必填：三个作用域的 API 密钥
# 系统按能力拆成三个作用域，可分别指向不同提供商或中转网关：
#   llm   -> 大语言模型，驱动 agent1 - agent7（脚本/分镜/审核等）
#   image -> 图像生成，驱动 agent8（文生图/参考图）
#   video -> 视频生成，驱动 agent9（图生视频）
# -------------------------------------------------------------

# 大语言模型 API 密钥（agent1-7 共用）
# 示例：sk-xxxxxxxxxxxxxxxxxxxx
VIDEO_AGENT_STUDIO_LLM_API_KEY=

# 大语言模型网关地址。留空 = 使用该提供商官方默认地址。
# 仅当使用 OpenAI 兼容中转（OpenRouter / SiliconFlow / 自建等）时需要填写，例如：
#   VIDEO_AGENT_STUDIO_LLM_BASE_URL=https://api.minimaxi.com/v1
VIDEO_AGENT_STUDIO_LLM_BASE_URL=

# 图像生成 API 密钥（agent8）
VIDEO_AGENT_STUDIO_IMAGE_API_KEY=

# 图像生成网关地址。规则同上（留空 = 官方默认；OpenAI 官方可留空）
VIDEO_AGENT_STUDIO_IMAGE_BASE_URL=

# 视频生成 API 密钥（agent9）
VIDEO_AGENT_STUDIO_VIDEO_API_KEY=

# 视频生成网关地址。规则同上（留空 = 官方默认）
VIDEO_AGENT_STUDIO_VIDEO_BASE_URL=


# -------------------------------------------------------------
# 二、可选：旧版兼容配置（仅在需要时填写）
# 下列变量对应早期版本 / 特定提供商的兼容入口。
# 使用上方主配置时一般无需填写，仅供特殊链路兜底。
# -------------------------------------------------------------

# OpenAI 官方兼容入口
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic 兼容入口（默认指向 MiniMax 的 Anthropic 兼容网关）
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.minimaxi.com/anthropic
# 若走 Anthropic 官方入口，可额外指定版本，例如：
#   ANTHROPIC_VERSION=2023-06-01

# MiniMax 官方兼容入口
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com/v1


# -------------------------------------------------------------
# 三、可选：本地数据加密密钥
# -------------------------------------------------------------

# 用于本地敏感数据的加密。留空 = 应用首次启动时在 .data/ 下自动生成。
# 生产 / 多实例部署建议显式设置为固定随机值，避免实例间密钥不一致。
VIDEO_AGENT_STUDIO_SECRET_KEY=


# -------------------------------------------------------------
# 四、模型选择参考
# 具体模型在 Settings 页面中按作用域配置，常用搭配如下：
#
#   OpenAI 官方：
#     agent1-7 -> gpt-5 / gpt-5-mini
#     agent8   -> gpt-image-1
#     agent9   -> sora-2
#
#   MiniMax（推荐搭配上方 api.minimaxi.com 网关）：
#     agent1-7 -> MiniMax-M2.5
#     agent8   -> image-01
#     agent9   -> MiniMax-Hailuo-2.3
# -------------------------------------------------------------
