VIDEO_AGENT_STUDIO_LLM_API_KEY=
VIDEO_AGENT_STUDIO_LLM_BASE_URL=
VIDEO_AGENT_STUDIO_IMAGE_API_KEY=
VIDEO_AGENT_STUDIO_IMAGE_BASE_URL=
VIDEO_AGENT_STUDIO_VIDEO_API_KEY=
VIDEO_AGENT_STUDIO_VIDEO_BASE_URL=

# Optional legacy fallbacks for official providers.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.minimaxi.com/anthropic
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
VIDEO_AGENT_STUDIO_SECRET_KEY=

# API keys are now backend-only configuration.
# Recommended approach:
# 1. Copy this file to .env.local
# 2. Fill the three scope-specific API keys:
#    - VIDEO_AGENT_STUDIO_LLM_API_KEY   -> agent1-7
#    - VIDEO_AGENT_STUDIO_IMAGE_API_KEY -> agent8
#    - VIDEO_AGENT_STUDIO_VIDEO_API_KEY -> agent9
# 3. If you use an OpenAI-compatible supplier (OpenRouter / SiliconFlow / custom),
#    also fill the matching *_BASE_URL env for that scope.
#
# OpenAI can omit the scope Base URL and use the provider defaults.
# 对国内 MiniMax / Anthropic 兼容入口，推荐显式填写 api.minimaxi.com 对应地址。
# VIDEO_AGENT_STUDIO_SECRET_KEY is optional; if omitted, the app generates a local encryption key under .data/.
#
# Set provider + model in the Settings page, but keep API credentials in backend env only.
# Recommended model defaults:
# agent1-7 -> gpt-5 / gpt-5-mini
# agent8   -> gpt-image-1
# agent9   -> sora-2
#
# MiniMax examples:
# agent1-7 -> MiniMax-M2.5
# agent8   -> image-01
# agent9   -> MiniMax-Hailuo-2.3

# Optional: if you want to override the local media folder location in your own runtime,
# keep the generated assets under .data and serve them through /api/media/local/*
